# Copy this file to `.env.local` for local development.
# Never commit real values. On Vercel, set these in Project Settings → Environment Variables.

# Public production URL (used for canonical URLs, sitemap and Open Graph metadata).
# Example: https://pamith.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional — enables the contact form (https://resend.com). Server-only, never exposed to the browser.
# If left empty, the contact section falls back to a direct email link.
RESEND_API_KEY=
# Address that receives contact form messages.
CONTACT_TO_EMAIL=
# Verified sender address/domain configured in Resend (e.g. "Portfolio <contact@yourdomain.com>").
CONTACT_FROM_EMAIL=
